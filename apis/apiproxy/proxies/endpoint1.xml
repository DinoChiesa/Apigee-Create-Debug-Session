<ProxyEndpoint name="endpoint1">
  <HTTPProxyConnection>
    <BasePath>/testable-v1</BasePath>
  </HTTPProxyConnection>

  <PreFlow name="PreFlow">
    <Request>
        <Step>
          <Condition>(request.verb = "POST") and NOT (request.header.content-type = "application/json")</Condition>
          <Name>RF-Invalid-Media-Type</Name>
        </Step>
    </Request>
    <Response>
      <Step>
        <Name>AM-Clean-Request-Headers-From-Response</Name>
      </Step>
    </Response>
  </PreFlow>

  <PostFlow name="PostFlow">
    <Response>
      <Step>
        <Name>AM-Inject-Proxy-Revision-Header</Name>
      </Step>
    </Response>
  </PostFlow>
  <DefaultFaultRule name="default-fault">
    <AlwaysEnforce>true</AlwaysEnforce>
    <Step>
      <Name>AM-Inject-Proxy-Revision-Header</Name>
    </Step>
  </DefaultFaultRule>

  <Flows>
    <Flow name="t1">
      <Description></Description>
      <Request>

        <Step>
          <Condition>request.header.authorization = null</Condition>
          <Name>RF-Missing-Authz-Header</Name>
        </Step>

        <Step>
          <Name>VerifyJWT-1</Name>
        </Step>

      </Request>
      <Response/>
      <Condition>(proxy.pathsuffix MatchesPath "/urlpath") and (request.verb = "GET")</Condition>
    </Flow>

    <Flow name="unknown-request">
      <Request>
        <Step>
          <Name>RF-Unknown-Request</Name>
        </Step>
      </Request>
      <Response/>
    </Flow>
  </Flows>

  <RouteRule name="default">
    <TargetEndpoint>target1</TargetEndpoint>
  </RouteRule>
</ProxyEndpoint>
